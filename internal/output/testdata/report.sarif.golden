{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "traits",
          "version": "0.1.0",
          "rules": [
            {
              "id": "colocate-small-domain-errors",
              "shortDescription": {
                "text": "Define small domain error types in the module that raises them."
              },
              "help": {
                "text": "Why: Keeps errors discoverable\nnext to the code that raises them.\nFix: Move the error next to its only caller."
              }
            },
            {
              "id": "explain-magic-numbers",
              "shortDescription": {
                "text": "Name or comment numeric literals other than 0 and 1."
              },
              "help": {
                "text": "Why: Readers should not have to guess what <42> means.\nFix: Introduce a named constant."
              }
            },
            {
              "id": "no-default-export",
              "shortDescription": {
                "text": "Use named exports; do not use `export default`."
              },
              "help": {
                "text": "Why: Named exports keep imports greppable & renames safe."
              }
            }
          ]
        }
      },
